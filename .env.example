# ==================================================
# SAFORI Server 환경변수
# 복사: cp .env.example .env
# ==================================================

# --- 서버 ---
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9082

# --- 프로파일 (local | alpha | prod) ---
SPRING_PROFILES_ACTIVE=local


# --- JWT ---
TOKEN_SECRET_USER=

# --- REDIS ---
REDIS_HOST=
REDIS_PORT=

# --- AWS S3 (음성 업로드 Presigned URL) ---
# 비워두면 S3 빈이 생성되지 않아 Presigned URL 발급만 비활성화 (서버는 정상 기동)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# --- Gemini (음성 분석 어댑터) ---
# 비워두면 분석 비활성화 (업로드/조회는 정상, analysisStatus는 PENDING 유지)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash