# ==================================================
# SAFORI Server 환경변수
# 복사: cp .env.example .env
# ==================================================

# --- 서버 ---
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=9082

# --- 프로파일 (local | alpha | prod) ---
SPRING_PROFILES_ACTIVE=local

# --- MySQL ---
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
TOKEN_SECRET_USER=

# --- REDIS ---
REDIS_HOST=
REDIS_PORT=

# --- AWS S3 (음성 업로드 Presigned URL) ---
# 비워두면 S3 빈이 생성되지 않아 Presigned URL 발급만 비활성화 (서버는 정상 기동)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# --- Gemini (음성 분석 어댑터) ---
# 비워두면 분석 비활성화 (업로드/조회는 정상, analysisStatus는 PENDING 유지)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Firebase (FCM 푸시 알림) ---
# 서비스 계정 키 JSON 을 base64 인코딩한 값. 비워두면 푸시 비활성화 (서버는 정상 기동)
# 생성: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_CREDENTIALS_BASE64=

# --- OpenAI (주간/월간 감정 리포트) ---
# 비워두면 리포트 생성 시 예외 (서버는 정상 기동, 다른 기능은 영향 없음)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- 챗봇: CBT 상담 대화 길이 ---
# 세션당 허용 사용자 발화 횟수. 마지막 발화의 응답이 도란이의 마무리 멘트가 되고 세션이 닫힌다.
# (마음일기 세션 기준: 도란이 질문 → 사용자 응답 이 횟수만큼 오간 뒤 종료)
# CHAT_MAX_USER_TURNS=4

# --- 챗봇: 마음일기 → 세션 자동 생성 정책 ---
# 10분 주기 스케줄러가 분석 완료된 일기를 훑어 조건에 맞으면 상담 '제안'을 만든다.
# (세션은 사용자가 모달에서 수락할 때 생성 — GET/POST /v1/api/chatbot/mind-diary-offer)
# 정책 변경은 대부분 아래 값만 바꿔 대응한다 (코드 배포 불필요).
# 규칙의 형태 자체가 바뀌면 SessionTriggerPolicy 구현체를 추가하고 POLICY 값을 바꾼다.
#
# ALWAYS: 일기 1건마다 세션 1개 (구 정책, 롤백용)
# CONSECUTIVE_NEGATIVE: N일 연속 부정 감정일 때만 세션 생성
# SESSION_TRIGGER_POLICY=CONSECUTIVE_NEGATIVE
# SESSION_TRIGGER_INTERVAL=PT10M
# 후보 스캔 범위. 넓히면 장애 복구 범위가 늘지만, 정책 변경 직후 과거 세션이 한꺼번에 생성될 수 있다.
# SESSION_TRIGGER_SCAN_LOOKBACK=PT48H
# 1회 실행당 최대 처리 건수 (LLM 호출 폭주 방지)
# SESSION_TRIGGER_BATCH_SIZE=50
# 세션 생성에 필요한 연속 부정 감정 일수
# SESSION_TRIGGER_CONSECUTIVE_DAYS=3
# "부정" 대분류 정의. 대분류가 바뀌면 이 값만 수정한다.
# SESSION_TRIGGER_NEGATIVE_EMOTIONS=SAD,ANGRY,ANXIETY
# 프롬프트에 넣을 일기 범위: TRIGGER_ONLY | FIXED_DAYS | STREAK
# SESSION_TRIGGER_CONTEXT_WINDOW=STREAK
# FIXED_DAYS 전용
# SESSION_TRIGGER_CONTEXT_WINDOW_DAYS=3
# 컨텍스트 일기 개수 상한 (프롬프트 토큰 비용 상한)
# SESSION_TRIGGER_MAX_CONTEXT_DIARIES=5

# --- 모니터링 (Sentry) ---
# local 은 아래 기본값(DSN 빈값 + OTEL_SDK_DISABLED=true)이면 비활성.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=safori-server
OTEL_PROPAGATORS=sentry
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# collector → Sentry forward
SENTRY_OTLP_TRACES_ENDPOINT=
SENTRY_OTLP_AUTH_HEADER=