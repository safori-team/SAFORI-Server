#!/bin/bash
# EC2 최초 부팅 스크립트 (Amazon Linux 2023). 로그: /var/log/cloud-init-output.log
set -euxo pipefail

dnf install -y docker git
systemctl enable --now docker

# blue/green 전환 중 앱 두 개(각 상한 2g)가 겹치므로 swap 2GB
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p ${app_dir}
docker network create ${docker_network} || true

%{ if auto_recovery ~}
# ASG 자동 복구: 앱 헬스를 30초마다 확인해 연속 실패 시 ASG 에 Unhealthy 보고.
# 이후 단계가 실패해도 보고는 돌도록 가장 먼저 설치한다.
echo "${health_script_b64}" | base64 -d > /usr/local/bin/safori-health-report
chmod 755 /usr/local/bin/safori-health-report
cat > /etc/systemd/system/safori-health.service <<'UNIT'
[Unit]
Description=SAFORI app health report to ASG
[Service]
Type=oneshot
Environment=APP_DIR=${app_dir} AWS_REGION=${region} CONTAINER_NAME=${container_name} DOCKER_NETWORK=${docker_network}
ExecStart=/usr/local/bin/safori-health-report
UNIT
cat > /etc/systemd/system/safori-health.timer <<'UNIT'
[Timer]
OnBootSec=60
OnUnitActiveSec=30
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now safori-health.timer

%{ endif ~}

# env-repo clone. deploy key 는 SSM Parameter Store(SecureString) ${deploy_key_param} 에 수동 등록.
# 없으면 건너뛴다 (등록 후 README 의 수동 clone 절차 실행).
mkdir -p /root/.ssh && chmod 700 /root/.ssh
if aws ssm get-parameter --region ${region} --name "${deploy_key_param}" --with-decryption \
     --query Parameter.Value --output text > /root/.ssh/env-repo-key 2>/dev/null; then
  chmod 600 /root/.ssh/env-repo-key
  ssh-keyscan github.com >> /root/.ssh/known_hosts
  export GIT_SSH_COMMAND="ssh -i /root/.ssh/env-repo-key -o IdentitiesOnly=yes"
  if [ ! -d ${app_dir}/env-repo/.git ]; then
    git clone "${env_repo_url}" ${app_dir}/env-repo
  fi
  # deploy.yml 의 git pull 도 같은 키를 쓰도록
  git -C ${app_dir}/env-repo config core.sshCommand "$GIT_SSH_COMMAND"
else
  rm -f /root/.ssh/env-repo-key
  echo "deploy key parameter ${deploy_key_param} not found; clone env-repo manually"
fi

# Cloudflare Tunnel 토큰(SSM ${tunnel_token_param})을 root 전용 env 파일로 둔다.
# cloudflared 는 배포 스크립트(remote-deploy.sh)가 blue/green 색깔마다 띄운다.
# 토큰이 로그에 찍히지 않도록 xtrace 를 끈다. 여기서 못 받으면 배포 스크립트가 다시 받는다.
set +x
if TOKEN=$(aws ssm get-parameter --region ${region} --name "${tunnel_token_param}" --with-decryption \
     --query Parameter.Value --output text 2>/dev/null); then
  (umask 077; printf 'TUNNEL_TOKEN=%s\n' "$TOKEN" > /root/cloudflared.env)
  unset TOKEN
else
  echo "tunnel token parameter ${tunnel_token_param} not found"
fi
set -x
%{ if auto_recovery ~}

# ASG 가 띄운 인스턴스: 마지막으로 성공한 배포(이미지 + 배포 스크립트, deploy.yml 이 SSM 에 기록)를 다시 띄운다.
# 아직 배포된 적이 없으면 no-release 표시만 남긴다(헬스 보고가 판정하지 않음).
if IMAGE=$(aws ssm get-parameter --region ${region} --name "${release_image_param}" --query Parameter.Value --output text 2>/dev/null) \
   && aws ssm get-parameter --region ${region} --name "${release_script_param}" --query Parameter.Value --output text 2>/dev/null \
      | base64 -d | gunzip > ${app_dir}/remote-deploy.sh; then
  IMAGE_URI="$IMAGE" AWS_REGION=${region} APP_DIR=${app_dir} CONTAINER_NAME=${container_name} \
    DOCKER_NETWORK=${docker_network} SPRING_PROFILE=${env} \
    bash ${app_dir}/remote-deploy.sh || echo "boot deploy failed; health report will trigger replacement"
else
  touch ${app_dir}/no-release
  echo "no release recorded yet; waiting for first deploy"
fi
%{ endif ~}
